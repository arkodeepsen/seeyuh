{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "nixPackages": ["glibc", "ffmpeg"],
    "buildCommand": "bash install_ffmpeg.sh && pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python start.py",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "never"
  }
}
